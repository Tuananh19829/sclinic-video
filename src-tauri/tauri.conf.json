{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sclinic Video",
  "version": "1.0.0",
  "identifier": "vn.sclinic.video",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sclinic Video",
        "width": 1680,
        "height": 1020,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0a0a0c",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sclinic",
    "copyright": "Sclinic Video — modified from shdw (C) 2026 d4niel-fr. AGPL-3.0 with attribution terms (see NOTICE).",
    "category": "Video",
    "shortDescription": "Trình dựng video AI tiếng Việt (dựa trên shdw)",
    "longDescription": "Sclinic Video is a modified version of shdw by d4niel-fr (https://github.com/d4niel-fr/shdw-video-editor): Vietnamese UI, named timeline tracks, Claude Code / Codex built in. Not an official shdw release.",
    "license": "AGPL-3.0-only",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "homepage": "https://github.com/Tuananh19829/sclinic-video"
  },
  "mainBinaryName": "Sclinic Video"
}